# From @BotFather
TELEGRAM_BOT_TOKEN=

# How Telegram delivers updates: polling (default, local dev) or webhook (production)
# BOT_TRANSPORT=polling

# Production webhook — public HTTPS URL Telegram will POST to (path must match your reverse proxy)
# BOT_TRANSPORT=webhook
# WEBHOOK_URL=https://your-domain.example/telegram/webhook
# Bind address/port for the built-in server (often behind nginx / Caddy; PORT may be 8080)
# WEBHOOK_LISTEN=0.0.0.0
# PORT=8080
# Optional: https://core.telegram.org/bots/api#setwebhook (secret_token)
# WEBHOOK_SECRET=

# Airtable: https://airtable.com/create/tokens — scopes: data.records:read for the base
AIRTABLE_PAT=

# Base ID from the API docs URL or base settings (starts with app...)
AIRTABLE_BASE_ID=

# Use dev Airtable vars when ENVIRONMENT=dev (default)
# ENVIRONMENT=dev
# AIRTABLE_PAT_DEV=
# AIRTABLE_BASE_ID_DEV=

# --- Airtable → Telegram notify webhook (separate process; use ngrok for local HTTPS) ---
# Shared secret: send header X-Notify-Secret: <value> or JSON field "secret" on POST /notify/airtable
# NOTIFY_WEBHOOK_SECRET=
# Uvicorn bind for notify_app only (default 8080)
# NOTIFY_HOST=127.0.0.1
# NOTIFY_PORT=8080

# Shared JSON file so bot (polling) and notify server (uvicorn) resolve chat_id without Airtable
# (default: .telegram_chat_store.json in current working directory)
# TELEGRAM_CHAT_STORE_PATH=/absolute/path/to/telegram_chat_store.json

# Optional: after /start or /myrequests, write Telegram chat id to Airtable field telegram_chat_id
# Requires PAT with data.records:write and a Number (or text) field named telegram_chat_id on sterilization_request
# SYNC_TELEGRAM_CHAT_ID=false
